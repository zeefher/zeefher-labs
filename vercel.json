{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/stock.py": {
      "maxDuration": 10
    },
    "api/pulso.py": {
      "maxDuration": 10
    },
    "api/nexo.py": {
      "maxDuration": 10
    },
    "api/zeeclima.py": {
      "maxDuration": 60,
      "includeFiles": "zeeclima/**"
    }
  },
  "headers": [
    {
      "source": "/estoque/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
